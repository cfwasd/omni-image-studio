# ==========================================
# OmniImage Studio 全象生图工作台 - 环境变量模板
# ==========================================

# 1. 数据库配置 (PostgreSQL)
# 格式: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/omni_image?schema=public"

# 2. JWT 登录会话加密密钥 (建议生产环境使用 openssl rand -hex 32 生成)
JWT_SECRET="omni-image-studio-super-secret-key-production-2026"

# 3. 阿里云 OSS 对象存储 (也可在系统运行后进入「配置中心」在线填写)
OSS_REGION="oss-cn-hangzhou"
OSS_ENDPOINT="" # 留空使用标准 Endpoint，内网访问填 oss-cn-hangzhou-internal.aliyuncs.com
OSS_BUCKET="your-bucket-name"
OSS_ACCESS_KEY_ID="LTAI5t..."
OSS_ACCESS_KEY_SECRET="your_access_key_secret"
OSS_CDN_DOMAIN="" # 可选，自定义加速域名如 https://cdn.yourdomain.com

# 4. 默认大语言模型（提示词扩写/翻译，也可在配置中心在线设置）
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY="sk-..."
LLM_MODEL="gpt-4o-mini"
